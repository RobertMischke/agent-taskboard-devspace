.proxy-dev.tmp.json
.proxy-stable.tmp.json
.dev-startup.log

# scratch logs & temp artifacts
_*
*.log
.codex-artifacts/

# generated concept/report HTML at repo root
/*.html

# per-task git worktrees of the inner app repo (dev & stable stay tracked)
/agent-taskboard-*/
!/agent-taskboard-dev/
!/agent-taskboard-stable/

# API-managed shared workspace — never tracked in the root repo
/agent-taskboard-workspace/

# personal Claude Code settings & runtime state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# one-off recovery/operator scripts dropped at the repo root by agent sessions
/.agent-studio-*

# test/verification residue (trx, logs, checkout zips) from operator gates
/agent-studio-verification/

# handoffs that carry incident details or secret fingerprints - never in a public repo
/artifacts/*secret*
/artifacts/*incident*
