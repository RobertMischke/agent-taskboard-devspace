{
  "name": "voice-studio-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/review",
    "frontend",
    "packages/writing-rules"
  ],
  "scripts": {
    "build:library": "npm run build -w @voice/review",
    "build:frontend": "npm run build -w @voice/studio",
    "build:backend": "dotnet build backend/VoiceStudio.Api/VoiceStudio.Api.csproj",
    "build": "npm run build:library && npm run build:writing-rules && npm run build:frontend && npm run build:backend",
    "start": "bash scripts/start.sh",
    "test:library": "npm test -w @voice/review",
    "test:e2e": "node scripts/verify-e2e.mjs",
    "test:backend": "dotnet run --project backend/VoiceStudio.Tests",
    "test:api": "node scripts/verify-api.mjs",
    "test:runner": "dotnet run --project backend/VoiceStudio.RunnerTests",
    "test:live": "node scripts/verify-live.mjs",
    "test:ui-state": "node scripts/verify-ui-state.mjs",
    "test:tasks": "dotnet run --project backend/VoiceStudio.TaskTests",
    "test:task-ui": "node scripts/verify-task-ui.mjs",
    "test:wiki-tasks": "node scripts/verify-wiki-tasks.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs",
    "review:website": "node scripts/import-website-review.mjs",
    "test:checks": "dotnet run --project backend/VoiceStudio.CheckTests/VoiceStudio.CheckTests.csproj",
    "website:build": "npm run build:library && npm run build:writing-rules && node scripts/build-website.mjs",
    "website:preview": "npm run website:build && node scripts/serve-website.mjs",
    "test:selection": "dotnet run --project backend/VoiceStudio.SelectionTests",
    "test:selection-ui": "node scripts/verify-selection-ui.mjs",
    "pairing-code": "node scripts/pairing-code.mjs",
    "build:frontend:staged": "npm run build -w @voice/studio -- --output-path dist/voice-studio-next",
    "frontend:publish-local": "node scripts/publish-built-frontend.mjs",
    "test:source-provenance": "node scripts/verify-source-provenance.mjs",
    "docs:dossier:check": "node scripts/integrations/sync-voice-lint-dossier.mjs",
    "docs:dossier:sync": "node scripts/integrations/sync-voice-lint-dossier.mjs --write",
    "test:dossier": "node scripts/integrations/verify-voice-lint-dossier.mjs",
    "test:holistic-schema": "node scripts/verify-holistic-examples.mjs",
    "test:website": "node scripts/verify-website.mjs",
    "test:selection-workflow": "node scripts/verify-selection-workflow.mjs",
    "test:navigation": "node scripts/verify-navigation-language.mjs",
    "test:wiki-i18n": "node scripts/verify-wiki-i18n.mjs",
    "test:evidence": "node scripts/verify-evidence.mjs",
    "test:session": "dotnet run --project backend/VoiceStudio.SessionTests",
    "test:session-ui": "node scripts/verify-session-ui-state.mjs",
    "test:browser-session": "node scripts/verify-browser-session.mjs",
    "test:library-types": "npm run test:types -w @voice/review",
    "build:writing-rules": "npm run build -w @voice/writing-rules",
    "test:writing-rules": "npm test -w @voice/writing-rules",
    "test:json-viewer": "node website/verify-json-viewer.mjs",
    "test:writing-patterns": "node website/verify-writing-patterns.mjs",
    "test:research": "node website/verify-research.mjs",
    "benchmark:writing-review": "npm run build:writing-rules && node benchmarks/writing-review/run.mjs",
    "benchmark:writing-review:retain": "node benchmarks/writing-review/retain.mjs",
    "benchmark:writing-review:prepare-models": "npm run build:writing-rules && node benchmarks/writing-review/prepare-model-comparison.mjs",
    "test:writing-review-models": "npm run build:writing-rules && node benchmarks/writing-review/verify-model-comparison.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "marked": "18.0.12",
    "typescript": "5.9.3"
  }
}
